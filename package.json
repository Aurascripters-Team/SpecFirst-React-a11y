{
  "name": "specfirst-react-a11y",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "specfirst:analyze": "tsx specfirst/cli/analyze.ts",
    "specfirst:classify": "tsx specfirst/cli/classify.ts",
    "specfirst:load-manifest": "tsx specfirst/cli/loadManifest.ts",
    "specfirst:freeze-spec": "tsx specfirst/cli/freezeSpec.ts",
    "specfirst:generate-tests": "tsx specfirst/cli/generateTests.ts",
    "specfirst:baseline": "tsx specfirst/cli/runBaseline.ts",
    "specfirst:demo": "vite --config vite.config.ts",
    "test:analysis": "tsx tests/analysis/runAnalysisFixtures.ts",
    "test:classification": "tsx tests/classification/runClassificationFixtures.ts",
    "test:manifest": "tsx tests/manifest/runManifestLoaderFixtures.ts",
    "test:spec": "tsx tests/spec/runFreezeSpecFixtures.ts",
    "test:test-generation": "tsx tests/test-generation/runTestGenerationFixtures.ts",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.3",
    "@playwright/test": "^1.60.0",
    "@types/node": "^25.8.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "ts-morph": "^26.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vite": "^8.0.13"
  },
  "dependencies": {
    "react": "^19.2.6",
    "react-dom": "^19.2.6"
  }
}
